# Copy to `.env` (gitignored) and fill in. Loaded automatically at startup.
#
#   cp .env.example .env
#
# Generate a passphrase:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
#
# This is the passphrase you type into the web app's unlock screen. Any string
# works locally; use a long random one for anything reachable from the internet.
BJJ_KEY=local-dev-secret

# https://console.groq.com/keys — free, no card required.
GROQ_API_KEY=

# SQLite file. On Fly, point this at the mounted volume.
DATABASE_PATH=./bjj-notes.db

# Optional model overrides.
# TRANSCRIBE_MODEL=whisper-large-v3
# STRUCTURE_MODEL=llama-3.3-70b-versatile
